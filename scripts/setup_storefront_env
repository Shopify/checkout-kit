  generate_platform_env_header
  write_quoted_env_assignment STOREFRONT_DOMAIN "$STOREFRONT_DOMAIN_VALUE"
  write_quoted_env_assignment STOREFRONT_ACCESS_TOKEN "$STOREFRONT_ACCESS_TOKEN_VALUE"
  write_quoted_env_assignment APPLE_PAY_MERCHANT_IDENTIFIER "$REACT_NATIVE_APPLE_PAY_MERCHANT_IDENTIFIER_VALUE"
  write_quoted_env_assignment API_VERSION "$API_VERSION_VALUE"

  cat <<EOF

# Buyer identity defaults
EOF
  write_quoted_env_assignment EMAIL "$EMAIL_VALUE"
  write_quoted_env_assignment ADDRESS_1 "$ADDRESS_1_VALUE"
  write_quoted_env_assignment ADDRESS_2 "$ADDRESS_2_VALUE"
  write_quoted_env_assignment CITY "$CITY_VALUE"
  write_quoted_env_assignment COMPANY "$COMPANY_VALUE"
  write_quoted_env_assignment COUNTRY "$COUNTRY_VALUE"
  write_quoted_env_assignment FIRST_NAME "$FIRST_NAME_VALUE"
  write_quoted_env_assignment LAST_NAME "$LAST_NAME_VALUE"
  write_quoted_env_assignment PROVINCE "$PROVINCE_VALUE"
  write_quoted_env_assignment ZIP "$ZIP_VALUE"
  write_quoted_env_assignment PHONE "$PHONE_VALUE"

  cat <<EOF

# Customer Account API (optional)
EOF
  write_quoted_env_assignment CUSTOMER_ACCOUNT_API_CLIENT_ID "$CUSTOMER_ACCOUNT_API_CLIENT_ID_VALUE"
  write_quoted_env_assignment CUSTOMER_ACCOUNT_API_SHOP_ID "$CUSTOMER_ACCOUNT_API_SHOP_ID_VALUE"
}

