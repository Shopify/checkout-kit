#!/usr/bin/env bash

set -o pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

mode="sync"

step_names=()
step_statuses=()
step_details=()
failure_count=0
last_status=0
storefront_ran=0
storefront_status=0
gemfile_lock_aligned=1

usage() {
  cat <<EOF
Usage: scripts/setup_dev_workspace [--check]

Runs all repo-owned setup steps and prints a final summary. Unlike dev up's
native provisioning tasks, this script keeps running independent setup steps
after one fails, then exits non-zero if anything failed.

This command prints paths and setup status only; it must not print configured
storefront values.
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --check)
      mode="check"
      ;;
    -h | --help)
      usage
      exit 0
      ;;
    *)
      usage >&2
      exit 1
      ;;
  esac
  shift
done

record_step() {
  local name="$1"
  local status="$2"
  local detail="$3"

  step_names+=("$name")
  step_statuses+=("$status")
  step_details+=("$detail")

  if [[ "$status" != "PASS" ]]; then
    failure_count=$((failure_count + 1))
  fi
}

status_icon() {
  case "$1" in
    PASS) printf '✅' ;;
    FAIL) printf '❌' ;;
    *) printf '•' ;;
  esac
}

run_shell() {
  local name="$1"
  local command="$2"
  local status

  printf '\n🔧 %s\n' "$name"
  (cd "$ROOT_DIR" && bash -c "$command")
  status=$?

  if [[ "$status" -eq 0 ]]; then
    printf '✅ PASS %s\n' "$name"
    record_step "$name" "PASS" ""
  else
    printf '❌ FAIL %s (exit %s)\n' "$name" "$status"
    record_step "$name" "FAIL" "exit $status"
  fi

  last_status="$status"
  return "$status"
}

ensure_storefront_env() {
  if [[ "$storefront_ran" -eq 1 ]]; then
    return "$storefront_status"
  fi

  if [[ "$mode" == "check" ]]; then
    run_shell "Sample storefront config" './scripts/setup_storefront_env --check'
  else
    run_shell "Sample storefront config" './scripts/setup_storefront_env'
  fi

  storefront_status="$last_status"
  storefront_ran=1
  return "$storefront_status"
}

check_gemfile_lock_alignment() {
  if run_shell "Gemfile.lock alignment" 'ruby scripts/check_gemfile_lock_alignment'; then
    gemfile_lock_aligned=1
  else
    gemfile_lock_aligned=0
  fi
}

run_bundle_step() {
  local name="$1"
  local command="$2"

  if [[ "$gemfile_lock_aligned" -eq 1 ]]; then
    run_shell "$name" "$command" || true
  else
    run_shell "$name" 'echo "Skipped: run ./scripts/check_gemfile_lock_alignment --fix to realign the lockfile above before installing gems (a diverged lockfile can hang bundle install)." >&2; false' || true
  fi
}

# TEMP (added 2026-06-05; safe to delete on/after ~2026-06-12, once everyone
# has run `dev up` at least once).
#
# The demo apps are being renamed from MobileBuyIntegration to
# CheckoutKit<Platform>Demo across a stack of PRs. Git removes the *tracked*
# files on each old path when others pull, but gitignored local artifacts
# (Storefront.xcconfig, xcuserdata, .DS_Store, .entitlements, build output) are
# left behind on every machine that had the old sample checked out. Remove the
# stale directories once.
#
# IMPORTANT: only list a path here in the same PR that performs the rename, so
# we never delete a sample that is still active on this branch.
#   - #238 Rename Swift demo app          -> platforms/swift/Samples/MobileBuyIntegration
#   - #239 Rename Android demo app         -> platforms/android/samples/MobileBuyIntegration
#   - #240 Rename React Native demo app    -> platforms/react-native/sample/ios/ReactNative{,.xcodeproj,.xcworkspace,Tests}
#                                            (RN sample dir itself was not renamed; only the
#                                             iOS Xcode project/app/tests, which keep gitignored
#                                             xcuserdata behind on the old paths.)
LEGACY_SAMPLE_DIRS=(
  "platforms/swift/Samples/MobileBuyIntegration"
  "platforms/android/samples/MobileBuyIntegration"
  "platforms/react-native/sample/ios/ReactNative.xcodeproj"
  "platforms/react-native/sample/ios/ReactNative.xcworkspace"
  "platforms/react-native/sample/ios/ReactNative"
  "platforms/react-native/sample/ios/ReactNativeTests"
)

cleanup_legacy_sample_dir() {
  local dir="$1"

  # Nothing to do once the stale directory is gone.
  if [[ ! -d "$ROOT_DIR/$dir" ]]; then
    return 0
  fi

  # Safety: never remove a directory that still has tracked files. After the
  # rename this should be empty; bail out (leaving it for manual review) if not.
  if [[ -n "$(cd "$ROOT_DIR" && git ls-files "$dir")" ]]; then
    run_shell "Legacy sample cleanup ($dir)" "echo 'Skipping: $dir still has tracked files; remove it manually.' >&2; false" || true
    return 0
  fi

  if [[ "$mode" == "check" ]]; then
    # Report "not met" so dev up runs the meet step and performs the removal.
    run_shell "Legacy sample cleanup ($dir)" "test ! -d \"$dir\"" || true
  else
    run_shell "Legacy sample cleanup ($dir)" "rm -rf \"$dir\"" || true
  fi
}

cleanup_legacy_samples() {
  local dir
  for dir in "${LEGACY_SAMPLE_DIRS[@]}"; do
    cleanup_legacy_sample_dir "$dir"
  done
}

setup_android() {
  ensure_storefront_env || true
}

setup_swift() {
  ensure_storefront_env || true

  if [[ "$mode" == "check" ]]; then
    run_shell "Swift bundle packages" 'BUNDLE_GEMFILE=platforms/swift/Gemfile bundle check' || true
    run_shell "Swift Mint packages" '
      set -e
      cd platforms/swift
      expected_swiftlint="$(sed -n "s#^realm/SwiftLint@##p" Mintfile)"
      expected_swiftformat="$(sed -n "s#^nicklockwood/SwiftFormat@##p" Mintfile)"
      expected_xcodegen="$(sed -n "s#^yonaskolb/XcodeGen@##p" Mintfile)"
      swiftlint_bin="$(../../scripts/swift_mint which swiftlint)"
      swiftformat_bin="$(../../scripts/swift_mint which swiftformat)"
      xcodegen_bin="$(../../scripts/swift_mint which xcodegen)"
      test -n "$expected_swiftlint"
      test -n "$expected_swiftformat"
      test -n "$expected_xcodegen"
      test "$("$swiftlint_bin" version)" = "$expected_swiftlint"
      test "$("$swiftformat_bin" --version)" = "$expected_swiftformat"
      test "$("$xcodegen_bin" version | sed "s/^Version: //")" = "$expected_xcodegen"
    ' || true
    run_shell "XcodeGen projects" 'cd platforms/swift && ./Scripts/generate_xcode_projects --check' || true
  else
    run_bundle_step "Swift bundle packages" 'BUNDLE_GEMFILE=platforms/swift/Gemfile bundle check || BUNDLE_GEMFILE=platforms/swift/Gemfile bundle install'
    run_shell "Swift Mint packages" 'cd platforms/swift && ../../scripts/swift_mint bootstrap' || true
    run_shell "XcodeGen projects" 'cd platforms/swift && ./Scripts/generate_xcode_projects' || true
  fi
}

setup_react_native() {
  ensure_storefront_env || true

  if [[ "$mode" == "check" ]]; then
    run_shell "React Native packages" 'test -d platforms/react-native/node_modules' || true
    run_shell "React Native iOS gems" 'cd platforms/react-native/sample/ios && bundle check' || true
  else
    run_shell "React Native packages" 'test -d platforms/react-native/node_modules || (cd platforms/react-native && pnpm install)' || true
    run_bundle_step "React Native iOS gems" 'cd platforms/react-native/sample/ios && (bundle check || bundle install)'
  fi
}

setup_web() {
  if [[ "$mode" == "check" ]]; then
    run_shell "Web packages" 'test -d platforms/web/node_modules' || true
  else
    run_shell "Web packages" 'test -d platforms/web/node_modules || (cd platforms/web && pnpm install)' || true
  fi
}

print_summary() {
  local index
  local status
  local detail
  local icon

  printf '\n📋 Setup summary\n'
  for index in "${!step_names[@]}"; do
    status="${step_statuses[$index]}"
    detail="${step_details[$index]}"
    icon="$(status_icon "$status")"
    if [[ -n "$detail" ]]; then
      printf '%s %-4s %s (%s)\n' "$icon" "$status" "${step_names[$index]}" "$detail"
    else
      printf '%s %-4s %s\n' "$icon" "$status" "${step_names[$index]}"
    fi
  done

  if [[ "$failure_count" -gt 0 ]]; then
    printf '\n⚠️  %s setup step(s) failed.\n' "$failure_count"
    printf 'Fix the failure, then rerun dev up from the repo root.\n'
  else
    printf '\n✅ All requested setup steps passed.\n'
  fi
}

cleanup_legacy_samples
check_gemfile_lock_alignment
setup_android
setup_swift
setup_react_native
setup_web

print_summary

if [[ "$failure_count" -gt 0 ]]; then
  exit 1
fi
