#!/usr/bin/env bash

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/../../.." && pwd)"
SAMPLES_DIR="$SCRIPT_DIR/../Samples"

if ! "$REPO_ROOT/scripts/setup_storefront_env" --check; then
    echo "Run dev up from the repo root to sync sample app storefront configuration."
    exit 1
fi

"$SCRIPT_DIR/generate_xcode_projects"

cd "$SAMPLES_DIR"

build_app() {
    if [[ ! -f "$1/Storefront.xcconfig" ]]; then
        echo "Missing Storefront.xcconfig for $1. Run dev up from the repo root."
        exit 1
    fi

    "$SCRIPT_DIR/xcode_run" "clean build" "$1"
}

build_app CheckoutKitSwiftDemo
build_app ShopifyAcceleratedCheckoutsApp
