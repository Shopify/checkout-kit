#!/bin/bash
set -eo pipefail

# Validate the public Swift API surface against committed .swiftinterface baselines.
#
# Usage:
#   ./Scripts/api check             # diff committed baselines vs current sources (CI gate)
#   ./Scripts/api dump              # regenerate committed baselines from current sources
#   ./Scripts/api diagnose [<ref>]  # diff baselines since <ref> without building (default origin/main)

SUBCOMMAND="${1:-}"
if [[ "$SUBCOMMAND" != "check" && "$SUBCOMMAND" != "dump" && "$SUBCOMMAND" != "diagnose" ]]; then
    echo "Usage: $0 {check|dump|diagnose [<ref>]}" >&2
    exit 1
fi

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SWIFT_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
PACKAGE_ROOT="$(cd "$SWIFT_ROOT/../.." && pwd)"
BASELINE_DIR="$SWIFT_ROOT/api"
MODULES=(EmbeddedCheckoutProtocol ShopifyCheckoutKit ShopifyAcceleratedCheckouts)

if [[ ! -f "$PACKAGE_ROOT/Package.swift" ]]; then
    echo "Error: Package.swift not found at $PACKAGE_ROOT" >&2
    exit 1
fi

WORK_DIR="$(mktemp -d)"
trap 'rm -rf "$WORK_DIR"' EXIT
DERIVED_DATA="$WORK_DIR/DerivedData"

# This build only produces API snapshots; distributed artifacts keep their normal
# settings. Pin the architecture so local and CI interfaces describe the same API.
# Interface verification is disabled because EmbeddedCheckoutProtocol's public enum
# shadows its module (swiftlang/swift#56573). Library evolution also warns about this,
# so warnings are not errors in this build. Normal builds still enforce them.
build_interfaces() {
    local cmd=(
        xcodebuild
        -scheme ShopifyCheckoutKit-Package
        -sdk iphonesimulator
        -destination "generic/platform=iOS Simulator"
        -derivedDataPath "$DERIVED_DATA"
        -skipPackagePluginValidation
        -disableAutomaticPackageResolution
        build
        ARCHS=arm64
        BUILD_LIBRARY_FOR_DISTRIBUTION=YES
        SWIFT_TREAT_WARNINGS_AS_ERRORS=NO
        'OTHER_SWIFT_FLAGS=$(inherited) -no-verify-emitted-module-interface'
    )

    local xcbeautify_args=""
    if [ "${GITHUB_ACTIONS:-}" = "true" ]; then
        xcbeautify_args="--renderer github-actions"
    fi

    cd "$PACKAGE_ROOT"
    if command -v xcbeautify >/dev/null 2>&1; then
        "${cmd[@]}" | xcbeautify $xcbeautify_args
    else
        "${cmd[@]}"
    fi
}

dump_module() {
    local module="$1"
    local out_path="$2"
    # Use the installed public interface, never .private or .package variants or
    # intermediate copies. The build always starts with fresh DerivedData.
    local interface="$DERIVED_DATA/Build/Products/Debug-iphonesimulator/$module.swiftmodule/arm64-apple-ios-simulator.swiftinterface"
    if [[ ! -s "$interface" ]]; then
        echo "Error: no public .swiftinterface emitted for $module at $interface" >&2
        return 1
    fi

    # Keep the format version and every declaration (including attributes,
    # conditional compilation and @inlinable bodies). Only build metadata is noise.
    sed -E '/^\/\/ swift-compiler-version:/d; /^\/\/ swift-module-flags(-ignorable)?:/d' "$interface" > "$out_path"
}

# A diff exit status of 1 means API drift; higher statuses are operational errors.
diff_interfaces() {
    local baseline="$1" current="$2" old_label="$3" new_label="$4"
    local status=0
    diff -u --label "$old_label" --label "$new_label" "$baseline" "$current" || status=$?
    if (( status > 1 )); then
        echo "Error: could not compare $old_label and $new_label" >&2
        exit "$status"
    fi
    return "$status"
}

diagnose_baselines() {
    local ref="$1"
    git -C "$SWIFT_ROOT" rev-parse --verify "$ref^{commit}" > /dev/null
    for module in "${MODULES[@]}"; do
        local filename="$module.swiftinterface"
        local previous="$WORK_DIR/$filename"
        if ! git -C "$SWIFT_ROOT" show "$ref:./api/$filename" > "$previous" 2>/dev/null; then
            echo "$module: no .swiftinterface baseline at $ref"
            continue
        fi
        if diff_interfaces "$previous" "$BASELINE_DIR/$filename" "$ref/$filename" "approved/$filename"; then
            echo "$module: unchanged since $ref"
        fi
    done
}

if [[ "$SUBCOMMAND" == "diagnose" ]]; then
    diagnose_baselines "${2:-origin/main}"
    exit 0
fi

echo "Building public Swift interfaces..."
build_interfaces

# Extract all modules before updating any approved baseline.
for module in "${MODULES[@]}"; do
    dump_module "$module" "$WORK_DIR/$module.swiftinterface"
done

case "$SUBCOMMAND" in
    dump)
        mkdir -p "$BASELINE_DIR"
        for module in "${MODULES[@]}"; do
            cp "$WORK_DIR/$module.swiftinterface" "$BASELINE_DIR/$module.swiftinterface"
            echo "Updated api/$module.swiftinterface"
        done
        ;;

    check)
        failed_modules=()
        for module in "${MODULES[@]}"; do
            filename="$module.swiftinterface"
            committed="$BASELINE_DIR/$filename"
            current="$WORK_DIR/$filename"
            if [[ ! -f "$committed" ]]; then
                echo "Error: missing committed baseline at $committed" >&2
                failed_modules+=("$module")
            elif ! diff_interfaces "$committed" "$current" "approved/$filename" "proposed/$filename"; then
                failed_modules+=("$module")
            fi
        done

        if (( ${#failed_modules[@]} > 0 )); then
            echo "Public Swift API drift detected in: ${failed_modules[*]}" >&2
            echo 'Run `dev swift api dump` to update the baseline if this change is intentional.' >&2
            exit 1
        fi
        echo "Public Swift API matches committed baselines for: ${MODULES[*]}"
        ;;
esac
