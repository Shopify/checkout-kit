// --- Storefront
// --- Find your Storefront API access token under:
// ----- https://admin.shopify.com/store/{STOREFRONT}/settings/apps/development/{APP_ID}/api_credentials
// --- Prefer the repo-root .env.example for shared setup, then run dev up or dev bootstrap.

// Configuration settings file format documentation can be found at:
// https://help.apple.com/xcode/#/dev745c5c974

STOREFRONT_DOMAIN = your-store.myshopify.com
STOREFRONT_ACCESS_TOKEN = your-public-storefront-access-token
API_VERSION = 2025-07
