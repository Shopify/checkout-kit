{
  "name": "@shopify/checkout-kit",
  "version": "4.0.0-alpha.5",
  "description": "A web component for embedding Shopify's Checkout Kit in any website.",
  "license": "MIT",
  "author": "Shopify",
  "homepage": "https://github.com/Shopify/checkout-kit/tree/main/platforms/web",
  "bugs": {
    "url": "https://github.com/Shopify/checkout-kit/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Shopify/checkout-kit.git",
    "directory": "platforms/web"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./shopify-checkout": {
      "types": "./dist/shopify-checkout.d.ts",
      "import": "./dist/shopify-checkout.js",
      "default": "./dist/shopify-checkout.js"
    },
    "./custom-elements.json": "./dist/custom-elements.json",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "./src/shopify-checkout.ts",
    "./components/shopify-checkout/src/register.ts",
    "./dist/shopify-checkout.js"
  ],
  "files": [
    "LICENSE",
    "README.md",
    "package.json",
    "dist"
  ],
  "keywords": [
    "shopify",
    "checkout",
    "web-components",
    "custom-elements",
    "headless-commerce",
    "ecommerce"
  ],
  "scripts": {
    "clean": "rm -rf dist dist-cdn sample/dist sample/dist-cdn coverage",
    "build": "pnpm run build:npm && pnpm run build:cdn",
    "build:manifest": "cem analyze --globs 'components/*/src/**/*.ts' --exclude '**/*.test.ts' --outdir dist",
    "dev": "vite build --watch",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "lint": "pnpm run typecheck && pnpm run sample:typecheck && pnpm run scripts:typecheck && pnpm run lint:compat && pnpm run lint:dependencies && pnpm run lint:js && pnpm run format:check",
    "lint:compat": "eslint --config eslint.compat.config.mjs src components internal",
    "lint:dependencies": "depcruise --config dependency-cruiser.config.mjs src components internal",
    "lint:js": "oxlint --report-unused-disable-directives --max-warnings 0 src components internal sample scripts && pnpm --dir test/e2e lint",
    "lint:js:fix": "oxlint --fix src components internal sample scripts && pnpm --dir test/e2e lint:fix",
    "format": "oxfmt src components internal sample scripts dependency-cruiser.config.mjs '!sample/dist/**' '!sample/dist-cdn/**' '!internal/telemetry/**' && pnpm --dir test/e2e format",
    "format:check": "oxfmt --check src components internal sample scripts dependency-cruiser.config.mjs '!sample/dist/**' '!sample/dist-cdn/**' '!internal/telemetry/**' && pnpm --dir test/e2e format:check",
    "typecheck": "tsc --noEmit",
    "sample": "vite --config sample/vite.config.ts",
    "sample:build": "vite build --config sample/vite.config.ts",
    "sample:preview": "vite preview --config sample/vite.config.ts",
    "sample:typecheck": "tsc --noEmit -p sample/tsconfig.json",
    "sample:cdn": "pnpm run build:npm && pnpm run sample:cdn:typecheck && vite --config sample/vite.config.ts --mode cdn",
    "sample:cdn:build": "pnpm run build:npm && pnpm run sample:cdn:typecheck && vite build --config sample/vite.config.ts --mode cdn",
    "sample:cdn:preview": "vite preview --config sample/vite.config.ts --mode cdn",
    "sample:cdn:typecheck": "tsc --noEmit -p sample/tsconfig.cdn.json",
    "verify": "publint && vitest run --config vitest.package.config.ts && tsc -p test/tsconfig.package.json",
    "snapshot": "./scripts/create_snapshot",
    "compare-snapshot": "./scripts/compare_snapshot",
    "prepack": "pnpm run build:npm",
    "scripts:typecheck": "tsc --noEmit -p scripts/tsconfig.json",
    "build:npm": "vite build && pnpm run build:manifest",
    "build:cdn": "vite build --config vite.cdn.config.ts"
  },
  "devDependencies": {
    "@custom-elements-manifest/analyzer": "^0.10.4",
    "@shopify/checkout-kit-component-checkout": "workspace:*",
    "@shopify/checkout-kit-protocol": "workspace:*",
    "@types/node": "^22.10.0",
    "@types/semver": "^7.8.0",
    "@typescript-eslint/parser": "^8.70.1",
    "@vitest/coverage-v8": "^4.1.0",
    "browserslist-to-esbuild": "^2.1.1",
    "dependency-cruiser": "17.3.10",
    "eslint": "^10.11.0",
    "eslint-plugin-compat": "^7.0.2",
    "happy-dom": "^20.8.9",
    "oxfmt": "^0.47.0",
    "oxlint": "^1.62.0",
    "publint": "^0.3.12",
    "rolldown-plugin-dts": "^0.28.6",
    "semver": "^7.8.5",
    "typescript": "5.9.3",
    "vite": "^8.3.4",
    "vitest": "^4.1.0",
    "@shopify/checkout-kit-core": "workspace:*"
  },
  "packageManager": "pnpm@10.33.1+sha512.05ba3c1d5d1c18f68df06470d74055e62d41fc110a0c660db1b2dfb2785327f04cf0f68345d4609bc52089e7fa0343c31593b2f9594e2c5d5da426230acc9820",
  "engines": {
    "node": ">=22.14.0"
  },
  "browserslist": [
    "Chrome >= 111",
    "ChromeAndroid >= 111",
    "Edge >= 111",
    "Firefox >= 111",
    "FirefoxAndroid >= 111",
    "Safari >= 16.4",
    "iOS >= 16.4"
  ],
  "customElements": "dist/custom-elements.json",
  "pnpm": {
    "overrides": {
      "brace-expansion@2": "2.1.7",
      "brace-expansion@5": "5.0.12",
      "fast-uri@3": "3.1.8",
      "nanoid@3": "3.3.20",
      "postcss@8": "8.5.29",
      "tinypool@2": "2.2.0",
      "source-map-js@1": "1.2.2",
      "picomatch@4": "4.0.7"
    }
  }
}
