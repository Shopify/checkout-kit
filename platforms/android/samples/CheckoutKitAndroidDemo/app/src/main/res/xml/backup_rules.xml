<?xml version="1.0" encoding="utf-8"?><!--
   Backup rules for API 30 and below. API 31+ uses res/xml/data_extraction_rules.xml;
   keep both files in sync.
   See https://developer.android.com/guide/topics/data/autobackup for details.
-->
<full-backup-content>
    <!-- Android Keystore keys are device-bound, so restored token ciphertext and keysets cannot be used. -->
    <exclude domain="file" path="datastore/customer_access_tokens.preferences_pb" />
    <exclude domain="file" path="datastore/customer_access_tokens.preferences_pb.tmp" />
    <exclude domain="sharedpref" path="customer_access_token_keyset.xml" />
</full-backup-content>
