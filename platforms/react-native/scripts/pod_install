#!/usr/bin/env bash

set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SAMPLE_DIR="$SCRIPT_DIR/../sample"

for arg in "$@"; do
  if [ "$arg" = "--local" ]; then
    export USE_LOCAL_SDK=1
  fi
done

cd "$SAMPLE_DIR"
./scripts/prebuild ios
cd ios
bundle check || bundle install
bundle exec pod install --repo-update
