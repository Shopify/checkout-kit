#!/usr/bin/env bash

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"
REPO_ROOT="$(cd "$ROOT_DIR/../.." && pwd)"
METRO_LOG="${TMPDIR:-/tmp}/checkout-kit-rn-ios-metro.log"
METRO_PID=""
E2E_ENV_FILE=""
APP_ID="com.shopify.checkoutkit.reactnativedemo"
CART_BOOTSTRAP_BASE_LINK="${APP_ID}://cart?productIndex=0&quantity=1"
MAESTRO_FLOWS=()
CUSTOMER_ACCOUNT_AUTH_ENABLED=0
E2E_CUSTOMER_ACCOUNT_CODE_VALUE="${E2E_CUSTOMER_ACCOUNT_CODE:-}"
unset E2E_CUSTOMER_ACCOUNT_CODE

usage() {
  cat <<EOF >&2
Usage: dev rn e2e ios [--guest] [--hardcoded-buyer-identity] [--customer-account]

Runs the full React Native iOS Maestro checkout suite against the benchmark-shop fixture by default.
Pass one or more focused scenario flags to run only those flows. Guest and hardcoded buyer identity
can use generic storefront configuration; customer account requires the benchmark-shop configuration.

Options:
  --guest                       Run only the guest checkout smoke flow.
  --hardcoded-buyer-identity    Run only the hardcoded buyer identity smoke flow.
  --customer-account            Run only the customer account checkout smoke flow.
EOF
}

add_maestro_flow() {
  local flow="$1"

  if [ "${#MAESTRO_FLOWS[@]}" -gt 0 ]; then
    for existing_flow in "${MAESTRO_FLOWS[@]}"; do
      if [ "$existing_flow" = "$flow" ]; then
        return
      fi
    done
  fi

  MAESTRO_FLOWS+=("$flow")
}

customer_account_configured() {
  local env_file="$ROOT_DIR/sample/.env"

  [ -f "$env_file" ] &&
    grep -Eq '^CUSTOMER_ACCOUNT_API_CLIENT_ID="[^"]+"$' "$env_file" &&
    grep -Eq '^CUSTOMER_ACCOUNT_API_SHOP_ID="[^"]+"$' "$env_file" &&
    grep -Eq '^CUSTOM_USER_AGENT="[^"]+"$' "$env_file" &&
    [ -n "$E2E_CUSTOMER_ACCOUNT_CODE_VALUE" ]
}

for arg in "$@"; do
  case "$arg" in
    --guest)
      add_maestro_flow "tests/react-native/checkout-guest.yaml"
      ;;
    --hardcoded-buyer-identity)
      add_maestro_flow "tests/react-native/checkout-hardcoded-buyer-identity.yaml"
      ;;
    --customer-account)
      CUSTOMER_ACCOUNT_AUTH_ENABLED=1
      add_maestro_flow "tests/react-native/checkout-customer-account.yaml"
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      usage
      echo "Unknown option: $arg" >&2
      exit 1
      ;;
  esac
done

if [ "${#MAESTRO_FLOWS[@]}" -eq 0 ]; then
  CUSTOMER_ACCOUNT_AUTH_ENABLED=1
  MAESTRO_FLOWS=(
    "tests/react-native/checkout-guest.yaml"
    "tests/react-native/checkout-hardcoded-buyer-identity.yaml"
    "tests/react-native/checkout-customer-account.yaml"
  )
fi

if [ "$CUSTOMER_ACCOUNT_AUTH_ENABLED" -eq 1 ] && ! customer_account_configured; then
  echo "Customer account checkout requires the benchmark-shop Customer Account API configuration, CUSTOM_USER_AGENT, and E2E_CUSTOMER_ACCOUNT_CODE." >&2
  echo "Configure the storefront values in the repository .env, export the private code, and run dev up; or run only --guest and/or --hardcoded-buyer-identity." >&2
  exit 1
fi

metro_running() {
  curl --silent --fail http://localhost:8081/status | grep -q "packager-status:running"
}

cleanup() {
  if [ -n "$METRO_PID" ]; then
    kill "$METRO_PID" 2>/dev/null || true
  fi

  if [ -n "$E2E_ENV_FILE" ]; then
    rm -f "$E2E_ENV_FILE"
  fi
}

prepare_e2e_env() {
  E2E_ENV_FILE="$(mktemp "${TMPDIR:-/tmp}/checkout-kit-rn-e2e-env.XXXXXX")"

  if [ -f "$ROOT_DIR/sample/.env" ]; then
    cp "$ROOT_DIR/sample/.env" "$E2E_ENV_FILE"
    printf "\n" >>"$E2E_ENV_FILE"
  fi

  printf "CHECKOUT_KIT_E2E_DISABLE_LOGBOX=1\n" >>"$E2E_ENV_FILE"

  if [ "$CUSTOMER_ACCOUNT_AUTH_ENABLED" -eq 1 ]; then
    printf "CUSTOMER_ACCOUNT_RESET_SESSION_ON_LAUNCH=1\n" >>"$E2E_ENV_FILE"
  fi
}

wait_for_metro() {
  for _ in $(seq 1 60); do
    if metro_running; then
      return 0
    fi
    sleep 1
  done

  echo "Timed out waiting for Metro. Last log lines:" >&2
  tail -n 40 "$METRO_LOG" >&2 || true
  return 1
}

require_maestro() {
  if ! maestro --version >/dev/null 2>&1; then
    echo "Maestro is required to run React Native E2E tests." >&2
    echo "Install Maestro and make sure maestro --version succeeds." >&2
    return 1
  fi
}

cd "$ROOT_DIR"

require_maestro
trap cleanup EXIT

if ! metro_running; then
  /opt/dev/bin/dev react-native start >"$METRO_LOG" 2>&1 &
  METRO_PID="$!"
fi

wait_for_metro
prepare_e2e_env
ENVFILE="$E2E_ENV_FILE" pnpm sample ios

(
  cd "$REPO_ROOT/e2e"
  for flow in "${MAESTRO_FLOWS[@]}"; do
    E2E_CUSTOMER_ACCOUNT_CODE="$E2E_CUSTOMER_ACCOUNT_CODE_VALUE" \
      maestro --platform ios test --config config.yaml \
      -e "APP_ID=${APP_ID}" \
      -e "CART_BOOTSTRAP_BASE_LINK=${CART_BOOTSTRAP_BASE_LINK}" \
      "$flow"
  done
)
