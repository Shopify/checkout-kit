{
  "name": "sample",
  "version": "0.6.0",
  "private": true,
  "scripts": {
    "android": "bash ./scripts/android",
    "clean": "rm -rf node_modules ios/build ios/Pods vendor",
    "clean:android": "(cd android && ./gradlew clean)",
    "build:android": "bash ./scripts/build_android",
    "release:android": "bash ./scripts/release_android",
    "build:ios": "sh ./scripts/build_ios",
    "lint": "pnpm run typecheck && eslint .",
    "ios": "bash ./scripts/ios",
    "start": "expo start --dev-client --clear",
    "typecheck": "tsc --noEmit",
    "test:ios": "sh ./scripts/test_ios",
    "test:android": "bash ./scripts/test_android"
  },
  "dependencies": {
    "@apollo/client": "^3.13.9",
    "@react-navigation/bottom-tabs": "^7.4.6",
    "@react-navigation/native": "^7.1.17",
    "@react-navigation/native-stack": "^7.3.25",
    "@react-navigation/stack": "^7.4.8",
    "@shopify/checkout-kit-react-native": "workspace:*",
    "graphql": "^16.8.2",
    "jotai": "^2.13.1",
    "react-native-reanimated": "4.3.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-webview": "13.16.1",
    "@expo/vector-icons": "~15.1.1",
    "expo": "~56.0.11",
    "expo-build-properties": "~56.0.18",
    "expo-constants": "~56.0.18",
    "expo-crypto": "~56.0.4",
    "expo-dev-client": "~56.0.20",
    "expo-font": "~56.0.6",
    "expo-secure-store": "~56.0.4",
    "react-native-gesture-handler": "~2.31.1",
    "react": "19.2.3",
    "react-native": "0.85.3",
    "react-native-worklets": "0.8.3",
    "expo-system-ui": "~56.0.5"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/plugin-proposal-nullish-coalescing-operator": "^7.18.6",
    "@babel/plugin-proposal-optional-chaining": "^7.21.0",
    "@babel/plugin-transform-arrow-functions": "^7.27.1",
    "@babel/plugin-transform-shorthand-properties": "^7.23.3",
    "@babel/plugin-transform-template-literals": "^7.23.3",
    "@babel/preset-env": "^7.20.0",
    "@babel/runtime": "^7.27.6",
    "@react-native-masked-view/masked-view": "^0.3.2",
    "@types/setimmediate": "^1",
    "babel-plugin-module-resolver": "^5.0.0",
    "setimmediate": "^1.0.5"
  },
  "engines": {
    "node": ">= 18"
  },
  "eslintConfig": {
    "root": true,
    "extends": "@react-native",
    "rules": {
      "no-console": "off",
      "@typescript-eslint/no-shadow": "off"
    },
    "overrides": [
      {
        "files": [
          "*.ts",
          "*.tsx"
        ],
        "rules": {
          "@typescript-eslint/consistent-type-imports": "error"
        }
      }
    ]
  },
  "expo": {
    "install": {
      "exclude": [
        "expo",
        "expo-build-properties",
        "expo-font"
      ]
    }
  }
}
