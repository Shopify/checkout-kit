#!/usr/bin/env bash

set -e

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
. "$SCRIPT_DIR/android_sccache"

args=()
for arg in "$@"; do
  if [ "$arg" = "--local" ]; then
    export USE_LOCAL_SDK=1
  else
    args+=("$arg")
  fi
done

"$SCRIPT_DIR/../../scripts/publish_android_snapshot"

cd android

if [ "${USE_LOCAL_SDK:-0}" = "1" ]; then
  args+=(--refresh-dependencies)
fi

./gradlew clean generateAndroidManifestFromTemplate test --no-daemon --console=plain -Dorg.gradle.workers.max=1 -PreactNativeArchitectures=arm64-v8a "${args[@]}"
