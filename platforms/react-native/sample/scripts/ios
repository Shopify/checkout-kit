#!/usr/bin/env bash

set -e

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"

args=()
use_local=0
for arg in "$@"; do
  if [ "$arg" = "--local" ]; then
    use_local=1
  else
    args+=("$arg")
  fi
done

if [ "$use_local" = "1" ]; then
  (cd "$SCRIPT_DIR/../.." && pnpm run pod-install -- --local)
fi

exec react-native run-ios "${args[@]}"
