#!/usr/bin/env bash

set -e

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"

args=()
sdk_flag="--local"
for arg in "$@"; do
  case "$arg" in
    --local) sdk_flag="--local" ;;
    --stable) sdk_flag="--stable" ;;
    *) args+=("$arg") ;;
  esac
done

if [ "$sdk_flag" = "--local" ]; then
  export USE_LOCAL_SDK=1
fi

(cd "$SCRIPT_DIR/../.." && pnpm run pod-install -- "$sdk_flag")

exec react-native run-ios "${args[@]}"
