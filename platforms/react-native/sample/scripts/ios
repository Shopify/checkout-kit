#!/usr/bin/env bash

set -e

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
SAMPLE_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"

args=()
for arg in "$@"; do
  if [ "$arg" = "--local" ]; then
    export USE_LOCAL_SDK=1
  else
    args+=("$arg")
  fi
done

cd "$SAMPLE_DIR"
bundle check || bundle install
(cd ios && bundle exec pod install)
exec pnpm exec expo run:ios --no-install "${args[@]}"
