 #!/usr/bin/env bash

set -ex
set -eo pipefail

# Add sccache for faster compilation. CI must opt in with SCCACHE_CI=true.
if [ "${SCCACHE:-}" = "false" ] || { [ "${CI:-}" = "true" ] && [ "${SCCACHE_CI:-}" != "true" ]; }; then
    if command -v sccache >/dev/null 2>&1; then
        sccache --stop-server 2>/dev/null || true
    fi
else
    if command -v sccache >/dev/null 2>&1; then
        export RUSTC_WRAPPER=sccache
        IOS_SCCACHE_SHIM_DIR="${TMPDIR:-/tmp}/checkout-kit-react-native-ios-sccache"
        mkdir -p "$IOS_SCCACHE_SHIM_DIR"
        cat > "$IOS_SCCACHE_SHIM_DIR/clang" <<'EOF'
#!/usr/bin/env sh
exec sccache /usr/bin/clang "$@"
EOF
        cat > "$IOS_SCCACHE_SHIM_DIR/clang++" <<'EOF'
#!/usr/bin/env sh
exec sccache /usr/bin/clang++ "$@"
EOF
        chmod +x "$IOS_SCCACHE_SHIM_DIR/clang" "$IOS_SCCACHE_SHIM_DIR/clang++"
        export CC="$IOS_SCCACHE_SHIM_DIR/clang"
        export CXX="$IOS_SCCACHE_SHIM_DIR/clang++"
    fi
fi

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/simulator"
dest="$(get_sim_destination)"

cd ios

xcbeautify_args=""
if [ "$CI" = "true" ]; then
    xcbeautify_args="--renderer github-actions"
fi

xcodebuild clean build \
    -workspace ReactNative.xcworkspace \
    -scheme ReactNative \
    -sdk iphonesimulator \
    -destination "$dest" \
    -skipPackagePluginValidation \
    GCC_PRECOMPILE_PREFIX_HEADER=YES \
    ASSETCATALOG_COMPILER_OPTIMIZATION=time \
    COMPILER_INDEX_STORE_ENABLE=NO \
| xcbeautify $xcbeautify_args
