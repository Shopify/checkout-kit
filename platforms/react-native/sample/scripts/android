#!/usr/bin/env bash

set -e

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
SAMPLE_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"
. "$SCRIPT_DIR/android_sccache"

args=()
for arg in "$@"; do
  if [ "$arg" = "--local" ]; then
    export USE_LOCAL_SDK=1
  else
    args+=("$arg")
  fi
done

if [ "${USE_LOCAL_SDK:-0}" = "1" ]; then
  "$SCRIPT_DIR/../../scripts/publish_android_snapshot"
fi

cd "$SAMPLE_DIR"
exec pnpm exec expo run:android --no-install "${args[@]}"
