{
  "name": "@shopify/checkout-kit-react-native",
  "description": "A React Native library for Shopify's Checkout Kit.",
  "version": "4.0.0-alpha.5",
  "repository": {
    "type": "git",
    "url": "https://github.com/Shopify/checkout-kit.git",
    "directory": "platforms/react-native"
  },
  "author": "Shopify",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Shopify/checkout-kit/issues"
  },
  "homepage": "https://github.com/Shopify/checkout-kit",
  "packageManager": "pnpm@10.33.1+sha512.05ba3c1d5d1c18f68df06470d74055e62d41fc110a0c660db1b2dfb2785327f04cf0f68345d4609bc52089e7fa0343c31593b2f9594e2c5d5da426230acc9820",
  "pnpm": {
    "onlyBuiltDependencies": [
      "unrs-resolver"
    ],
    "overrides": {
      "shell-quote": "1.12.0",
      "qs": ">=6.15.2",
      "flatted": ">=3.4.2",
      "minimatch@9": ">=9.0.7",
      "glob@10": ">=10.5.0",
      "picomatch": ">=4.0.4",
      "js-yaml@3": "3.15.2",
      "js-yaml@4": "4.3.2",
      "brace-expansion@1": "1.1.21",
      "brace-expansion@2": "2.1.7",
      "brace-expansion@5": "5.0.12",
      "fast-uri@3": "3.1.8",
      "nanoid@3": "3.3.20",
      "ws@6": "6.2.6",
      "ws@7": "7.5.13",
      "@babel/core": ">=7.29.6",
      "@babel/plugin-transform-modules-systemjs": ">=7.29.4",
      "lodash": ">=4.18.0",
      "handlebars": "4.7.10",
      "fast-xml-parser": ">=5.7.0",
      "compression@1": "1.8.2",
      "joi@17": "17.13.8",
      "browserslist@4": "4.29.3",
      "baseline-browser-mapping@2": "2.11.28"
    }
  },
  "scripts": {
    "clean": "rm -rf lib",
    "sample": "pnpm --filter sample",
    "module": "pnpm --filter @shopify/checkout-kit-react-native",
    "pod-install": "bash ./scripts/pod_install",
    "snapshot": "./scripts/create_snapshot",
    "compare-snapshot": "./scripts/compare_snapshot",
    "test": "jest",
    "build": "vite build && pnpm verify",
    "lint": "pnpm typecheck && eslint src components internal && pnpm lint:dependencies",
    "typecheck": "tsc --noEmit",
    "api:check": "pnpm build && api-extractor run --verbose",
    "api:dump": "pnpm build && api-extractor run --local --verbose",
    "lint:dependencies": "depcruise --config dependency-cruiser.config.mjs src components internal",
    "verify": "node scripts/verify-package.mjs && tsc -p test/package-consumer/tsconfig.json && node --test scripts/verify-packed-package.mjs"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@microsoft/api-extractor": "^7.58.7",
    "@react-native-community/cli": "19.1.2",
    "@react-native-community/cli-platform-android": "19.1.2",
    "@react-native-community/cli-platform-ios": "19.1.2",
    "@react-native/babel-preset": "0.80.2",
    "@react-native/eslint-config": "0.80.2",
    "@react-native/metro-config": "0.80.2",
    "@react-native/typescript-config": "0.80.2",
    "@shopify/checkout-kit-protocol": "workspace:*",
    "@testing-library/react-native": "^13.3.1",
    "@tsconfig/react-native": "^3.0.6",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.1.0",
    "@types/react-native-dotenv": "^0.2.1",
    "@types/react-test-renderer": "19.1.0",
    "eslint": "^8.57.1",
    "eslint-plugin-prettier": "^5.5.4",
    "jest": "^30.0.5",
    "prettier": "^3.2.5",
    "react": "19.1.0",
    "react-native": "0.80.2",
    "react-native-dotenv": "^3.4.11",
    "react-native-gesture-handler": "2.26.0",
    "react-native-gradle-plugin": "^0.71.19",
    "react-test-renderer": "19.1.0",
    "ts-jest": "^29.4.1",
    "typescript": "^5.9.2",
    "@shopify/checkout-kit-react-native-core": "workspace:*",
    "@shopify/checkout-kit-react-native-checkout": "workspace:*",
    "@shopify/checkout-kit-react-native-accelerated": "workspace:*",
    "dependency-cruiser": "17.3.9",
    "vite": "^8.3.4",
    "vite-plugin-dts": "^4.5.4",
    "@types/node": "^22.12.0",
    "metro": "0.82.5",
    "@react-native/codegen": "0.80.2",
    "@rolldown/plugin-babel": "^0.2.4",
    "@types/babel__core": "^7.20.5",
    "rolldown": "~1.2.13"
  },
  "prettier": {
    "arrowParens": "avoid",
    "bracketSameLine": true,
    "bracketSpacing": false,
    "singleQuote": true,
    "trailingComma": "all",
    "semi": true,
    "useTabs": false,
    "proseWrap": "always"
  },
  "keywords": [
    "react-native",
    "shopify",
    "checkout"
  ],
  "main": "lib/index.cjs",
  "types": "lib/index.d.ts",
  "module": "lib/index.js",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "checkoutKit": {
    "nativeSdkVersions": {
      "ios": "4.0.0-alpha.8",
      "android": "4.0.0-alpha.8"
    }
  },
  "files": [
    "LICENSE",
    "README.md",
    "package.json",
    "ios",
    "android",
    "lib",
    "*.podspec",
    "!ios/Package.swift",
    "!ios/Tests",
    "!ios/build",
    "!android/src/test",
    "!android/build",
    "!android/gradle",
    "!android/gradlew",
    "!android/gradlew.bat",
    "!android/local.properties",
    "!**/*.spec.*",
    "!**/*.test.*",
    "!**/.*",
    "internal/core/src/specs"
  ],
  "peerDependencies": {
    "react": "*",
    "react-native": "*"
  },
  "dependencies": {},
  "bundledDependencies": [
    "@shopify/checkout-kit-protocol"
  ],
  "codegenConfig": {
    "name": "RNShopifyCheckoutKitSpec",
    "type": "all",
    "jsSrcsDir": "internal/core/src/specs",
    "android": {
      "javaPackageName": "com.shopify.checkoutkit"
    },
    "ios": {
      "modulesProvider": {
        "ShopifyCheckoutKit": "RCTShopifyCheckoutKit"
      },
      "componentProvider": {
        "RCTAcceleratedCheckoutButtons": "RCTAcceleratedCheckoutButtonsManager"
      }
    }
  },
  "react-native": "lib/index.js"
}
