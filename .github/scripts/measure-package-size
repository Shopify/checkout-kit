#!/usr/bin/env bash

set -euo pipefail

script_repo_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)
repo_root=${PACKAGE_SIZE_REPO_ROOT:-"$script_repo_root"}

measure_web=${MEASURE_WEB:-true}
measure_web_cdn=${MEASURE_WEB_CDN:-true}
measure_react_native=${MEASURE_REACT_NATIVE:-true}
measure_android=${MEASURE_ANDROID:-true}

size_bytes() {
  local file=$1

  stat -c "%s" "$file" 2>/dev/null || stat -f "%z" "$file"
}

human_bytes() {
  local bytes=$1

  awk -v bytes="$bytes" 'BEGIN {
    split("B KiB MiB GiB", units, " ");
    value = bytes;
    unit = 1;
    while (value >= 1024 && unit < 4) {
      value = value / 1024;
      unit++;
    }
    if (unit == 1) {
      printf "%d %s", value, units[unit];
    } else {
      printf "%.1f %s", value, units[unit];
    }
  }'
}

record_artifact() {
  local platform=$1
  local artifact=$2
  local file=$3
  local bytes

  bytes=$(size_bytes "$file")
  printf "%s\t%s\t%s\n" "$platform" "$artifact" "$bytes" >> "$output_file"
}

# Emit one detail row per file inside a packed artifact. Detail rows carry a
# fourth column (the file path) so the renderer can tell them apart from the
# artifact summary rows above and group them into a collapsible breakdown.
# Sizes are the uncompressed on-disk sizes of each entry.
record_tarball_breakdown() {
  local platform=$1
  local artifact=$2
  local tarball=$3
  local dir
  local file
  local rel

  dir=$(mktemp -d "${TMPDIR:-/tmp}/checkout-kit-explode.XXXXXX")
  tar -xzf "$tarball" -C "$dir"

  while IFS= read -r file; do
    rel=${file#"$dir/"}
    rel=${rel#package/}
    printf "%s\t%s\t%s\t%s\n" "$platform" "$artifact" "$(size_bytes "$file")" "$rel" >> "$output_file"
  done < <(find "$dir" -type f | sort)

  rm -rf "$dir"
}

record_zip_breakdown() {
  local platform=$1
  local artifact=$2
  local archive=$3
  local dir
  local file
  local rel

  dir=$(mktemp -d "${TMPDIR:-/tmp}/checkout-kit-explode.XXXXXX")
  unzip -qq "$archive" -d "$dir"

  while IFS= read -r file; do
    rel=${file#"$dir/"}
    printf "%s\t%s\t%s\t%s\n" "$platform" "$artifact" "$(size_bytes "$file")" "$rel" >> "$output_file"
  done < <(find "$dir" -type f | sort)

  rm -rf "$dir"
}

measure_web_package() {
  local pack_dir
  local tarball

  pack_dir=$(mktemp -d "${TMPDIR:-/tmp}/checkout-kit-web-pack.XXXXXX")
  (
    cd "$repo_root/platforms/web"
    # `prepack` runs `build:npm`; the CDN build is not in the package.
    pnpm pack --pack-destination "$pack_dir"
  )

  tarball=$(find "$pack_dir" -name "*.tgz" -type f -print -quit)
  local js_dir
  js_dir=$(mktemp -d "${TMPDIR:-/tmp}/checkout-kit-web-js.XXXXXX")
  tar -xzf "$tarball" -C "$js_dir"
  record_web_javascript "$js_dir/package/dist" "JavaScript"
  rm -rf "$js_dir"
  record_artifact "Web" "npm tarball" "$tarball"
  record_tarball_breakdown "Web" "npm tarball" "$tarball"
  rm -rf "$pack_dir"

  if [[ "$measure_web_cdn" == "true" ]]; then
    (
      cd "$repo_root/platforms/web"
      pnpm build:cdn
    )
    record_web_javascript "$repo_root/platforms/web/dist-cdn" "CDN JavaScript" true
  fi
}

record_web_javascript() {
  local directory=$1
  local artifact=$2
  local details=${3:-false}
  local file
  local bytes
  local compressed_bytes
  local javascript_bytes=0
  local gzip_bytes=0
  local js_count=0

  # Sum gzip sizes per file, matching separately compressed HTTP responses.
  # Declarations and source maps are not runtime JavaScript.
  while IFS= read -r file; do
    bytes=$(size_bytes "$file")
    javascript_bytes=$((javascript_bytes + bytes))
    compressed_bytes=$(gzip -n -9 -c "$file" | wc -c)
    gzip_bytes=$((gzip_bytes + compressed_bytes))
    js_count=$((js_count + 1))
    if [[ "$details" == "true" ]]; then
      printf "Web\t%s\t%s\t%s\n" "$artifact" "$bytes" "${file#"$directory/"}" >> "$output_file"
      printf "Web\t%s (gzip)\t%s\t%s\n" "$artifact" "$((compressed_bytes))" "${file#"$directory/"}" >> "$output_file"
    fi
  done < <(find "$directory" -type f \( -name '*.js' -o -name '*.mjs' -o -name '*.cjs' \) | sort)
  if [[ "$js_count" -eq 0 ]]; then
    echo "No shipped web $artifact found" >&2
    return 1
  fi
  printf "Web\t%s\t%s\n" "$artifact" "$javascript_bytes" >> "$output_file"
  printf "Web\t%s (gzip)\t%s\n" "$artifact" "$gzip_bytes" >> "$output_file"
}

measure_react_native_package() {
  local pack_dir
  local tarball

  pack_dir=$(mktemp -d "${TMPDIR:-/tmp}/checkout-kit-react-native-pack.XXXXXX")
  (
    cd "$repo_root/platforms/react-native"
    pnpm module clean
    pnpm module build
    if [[ -f modules/@shopify/checkout-kit-react-native/package.json ]]; then
      cd modules/@shopify/checkout-kit-react-native
    fi
    pnpm pack --pack-destination "$pack_dir"
  )

  tarball=$(find "$pack_dir" -name "*.tgz" -type f -print -quit)
  record_artifact "React Native" "npm tarball" "$tarball"
  record_tarball_breakdown "React Native" "npm tarball" "$tarball"
}

measure_android_package() {
  local module="shopify-checkout-kit"
  [[ -d "$repo_root/platforms/android/$module" ]] || module="lib"
  local task="assembleRelease"
  local aar="$repo_root/platforms/android/$module/build/outputs/aar/$module-release.aar"
  if [[ -d "$repo_root/platforms/android/shopify-checkout" ]]; then
    task="assemble"
    aar="$repo_root/platforms/android/$module/build/outputs/aar/$module.aar"
  fi

  (
    cd "$repo_root/platforms/android"
    ./gradlew ":$module:$task" --console=plain
  )

  record_artifact "Android" "release AAR" "$aar"
  record_zip_breakdown "Android" "release AAR" "$aar"
}

collect_measurements() {
  output_file=${1:?usage: measure-package-size collect <output-file>}
  : > "$output_file"

  if [[ "$measure_web" == "true" ]]; then
    measure_web_package
  fi

  if [[ "$measure_react_native" == "true" ]]; then
    measure_react_native_package
  fi

  if [[ "$measure_android" == "true" ]]; then
    measure_android_package
  fi
}

render_comment() {
  local base_file=${1:?usage: measure-package-size render <base-file> <head-file> <output-file>}
  local head_file=${2:?usage: measure-package-size render <base-file> <head-file> <output-file>}
  local comment_file=${3:?usage: measure-package-size render <base-file> <head-file> <output-file>}
  local budgets_file=${4:-"$script_repo_root/.ci/bundle-size-budgets.json"}
  node - "$script_repo_root" "$budgets_file" "$base_file" "$head_file" "$comment_file" <<'NODE'
const fs = require("node:fs");
const path = require("node:path");
const policy = require(path.join(process.argv[2], ".github/scripts/bundle-size-budgets.cjs"));
const budgets = JSON.parse(fs.readFileSync(process.argv[3], "utf8"));
const base = policy.measurements(fs.readFileSync(process.argv[4], "utf8"));
const head = policy.measurements(fs.readFileSync(process.argv[5], "utf8"));
const measuredPlatforms = Object.keys(policy.platforms).filter((platform) =>
  [...Object.keys(base), ...Object.keys(head)].some((key) => key.startsWith(`${policy.platforms[platform].label}\t`)),
);
fs.writeFileSync(process.argv[6], policy.render({budgets, base, head, measuredPlatforms}));
NODE
}

command=${1:-comment}

case "$command" in
  collect)
    collect_measurements "$2"
    ;;
  render)
    render_comment "$2" "$3" "$4" "${5:-}"
    ;;
  comment)
    output_file=${2:-"$repo_root/package-size-comment.md"}
    rows_file=$(mktemp "${TMPDIR:-/tmp}/checkout-kit-package-size-rows.XXXXXX")
    trap 'rm -f "$rows_file"' EXIT
    collect_measurements "$rows_file"
    render_comment /dev/null "$rows_file" "$output_file"
    ;;
  *)
    echo "Usage: measure-package-size {collect <output-file>|render <base-file> <head-file> <comment-file> [budgets-file]|comment [comment-file]}" >&2
    exit 1
    ;;
esac
