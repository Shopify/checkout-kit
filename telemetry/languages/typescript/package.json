{
  "name": "@shopify/checkout-kit-telemetry",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --report-unused-disable-directives --max-warnings 0 src test && pnpm run format:check",
    "format": "oxfmt src test",
    "format:check": "oxfmt --check src test"
  },
  "dependencies": {
    "@shopify/checkout-kit-protocol": "workspace:*"
  },
  "devDependencies": {
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "typescript": "6.0.3",
    "vitest": "^4.1.0"
  }
}
