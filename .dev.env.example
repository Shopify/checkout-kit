# Local developer tooling preferences for `dev` commands.
#
# Enable overrides:
#   cp .dev.env.example .dev.env
#
# This file is not for sample app configuration. Keep storefront values in .env.

# Editor used by `dev rn open` and `dev web open` for JS workspaces.
# When unset, those commands fall back to macOS `open`.
DEV_EDITOR=code
