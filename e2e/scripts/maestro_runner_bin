#!/usr/bin/env bash
set -euo pipefail

E2E_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
VERSIONS_ROOT="${MAESTRO_RUNNER_VERSIONS_ROOT:-$HOME/.maestro-runner-versions}"
version="$(tr -d '[:space:]' <"$E2E_ROOT/.maestro-runner-version")"
binary="$VERSIONS_ROOT/$version/maestro-runner"

if [ ! -x "$binary" ]; then
  echo "maestro_runner_bin: maestro-runner $version is not installed at $binary." >&2
  echo "  run: scripts/install_maestro_runner" >&2
  exit 1
fi

printf '%s\n' "$binary"
