#!/usr/bin/env bash

set -euo pipefail

# Lint rule: E2E tests and flows must call flows/app/hide-keyboard.yaml instead of invoking
# hideKeyboard directly, so platform-specific safety checks stay centralized.
script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
e2e_root="${1:-$(cd "$script_dir/.." && pwd)}"
e2e_root="${e2e_root%/}"
allowed_path="$e2e_root/flows/app/hide-keyboard.yaml"
violations=()

while IFS= read -r -d '' path; do
  if [ "$path" != "$allowed_path" ] && grep -Eq '^[[:space:]]*-[[:space:]]*hideKeyboard([[:space:]]|$)' "$path"; then
    violations+=("${path#"$e2e_root/"}")
  fi
done < <(find "$e2e_root" -type f \( -name '*.yaml' -o -name '*.yml' \) -print0)

if [ "${#violations[@]}" -eq 0 ]; then
  exit 0
fi

printf '%s\n' 'Direct hideKeyboard commands are only allowed in flows/app/hide-keyboard.yaml.' >&2
printf '%s\n' 'Call the reusable hide-keyboard flow instead:' >&2
printf '  %s\n' "${violations[@]}" >&2
exit 1
