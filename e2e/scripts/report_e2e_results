#!/usr/bin/env ruby
# frozen_string_literal: true

require "json"
require "optparse"
require_relative "../lib/bitrise_pipeline_stages"
require_relative "../lib/e2e_github_reporter"
require_relative "../lib/github_token"

options = {
  results_root: ENV["E2E_BROWSERSTACK_RESULTS_DIR"] || File.join(Dir.pwd, "e2e-results"),
  repository: ENV["GITHUB_REPOSITORY"] || "Shopify/checkout-kit",
  pr_number: ENV["BITRISE_PULL_REQUEST"],
  token: GitHubToken.resolve,
  branch: ENV["BITRISE_GIT_BRANCH"],
  expected: ENV["E2E_BROWSERSTACK_RUN_PLAN_COUNT"],
  run_plan: ENV["E2E_BROWSERSTACK_RUN_PLAN_JSON"],
  finished_workflows: ENV["BITRISEIO_FINISHED_WORKFLOWS"],
  pipeline_url: ENV["BITRISEIO_PIPELINE_BUILD_URL"]
}

OptionParser.new do |opts|
  opts.on("--results-root PATH") { |path| options[:results_root] = path }
  opts.on("--repository REPOSITORY") { |repository| options[:repository] = repository }
  opts.on("--pr NUMBER") { |number| options[:pr_number] = number }
  opts.on("--branch BRANCH") { |branch| options[:branch] = branch }
  opts.on("--expected COUNT", Integer) { |count| options[:expected] = count }
  opts.on("--run-plan PATH") { |path| options[:run_plan] = path }
  opts.on("--finished-workflows JSON") { |json| options[:finished_workflows] = json }
  opts.on("--pipeline-url URL") { |url| options[:pipeline_url] = url }
end.parse!

pr_number = options[:pr_number].to_s.strip
if pr_number.empty? || pr_number == "false" || pr_number == "0"
  pr_number = nil
else
  abort "token is required" if options[:token].to_s.strip.empty?

  pr_number = Integer(pr_number)
end

expected_raw = options[:expected]
expected = expected_raw.nil? || expected_raw.to_s.strip.empty? ? nil : Integer(expected_raw)

result_paths = Dir.glob(File.join(options.fetch(:results_root), "**", "result.json"))
if result_paths.empty?
  warn "No E2E result files found under #{options.fetch(:results_root)}"
  exit 1 if expected.nil?

  warn "Publishing an incomplete report: expected #{expected} run(s), found 0"
end

results = result_paths.sort.map { |path| JSON.parse(File.read(path)) }
tophat_manifest = JSON.parse(File.read(File.expand_path("../../scripts/tophat/targets.json", __dir__)))

run_plan_path = options[:run_plan].to_s.strip
run_plan = run_plan_path.empty? || !File.exist?(run_plan_path) ? [] : JSON.parse(File.read(run_plan_path))

stages = BitrisePipelineStages.from_json(
  options[:finished_workflows],
  app_slug: tophat_manifest.fetch("app_slug")
)

reporter = E2EGitHubReporter.new(
  results,
  repository: options.fetch(:repository),
  pr_number: pr_number,
  token: options.fetch(:token),
  branch: options.fetch(:branch),
  app_slug: tophat_manifest.fetch("app_slug"),
  targets: tophat_manifest.fetch("targets"),
  expected: expected,
  run_plan: run_plan,
  stages: stages,
  pipeline_url: options[:pipeline_url]
)
puts reporter.markdown_summary
if pr_number
  reporter.publish!
else
  warn "No pull request associated with this build; skipping GitHub E2E report"
end
exit(reporter.conclusion == "success" ? 0 : 1)
