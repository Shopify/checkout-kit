#!/usr/bin/env bash

set -euo pipefail

e2e_log() {
  printf '\n==> %s\n' "$*"
}

e2e_enable_corepack() {
  e2e_log "Enabling Corepack"
  corepack enable
}

e2e_deploy_dir() {
  local dir="$BITRISE_DEPLOY_DIR/e2e"
  mkdir -p "$dir"
  printf '%s\n' "$dir"
}

# Writes the changed file list and prints its path. Two gates read it — the E2E matrix
# and the iOS CI run plan — and a second copy of this derivation would let them select
# different work from the same commit.
#
# PR builds: the checkout is a shallow merge commit, so the GitHub API is the
# authoritative source for the PR's changed files. Non-PR runs (manual, scheduled,
# local) fall back to diffing the branch against its base with a three-dot range
# (changes since the merge-base, not tip-to-tip).
e2e_changed_files_file() {
  local changed_files
  changed_files="$(mktemp "${TMPDIR:-/tmp}/checkout-kit-changed-files.XXXXXX")"
  if [ -n "${BITRISE_PULL_REQUEST:-}" ]; then
    ruby e2e/scripts/github_pr_changed_files > "$changed_files"
  else
    git diff --name-only "${BITRISE_GIT_BRANCH_DEST:-origin/main}...HEAD" > "$changed_files"
  fi
  printf '%s\n' "$changed_files"
}

# Writes the branch-head bitrise.yml and prints its path. Bitrise resolves the pipeline
# graph from the branch head (before the merge checkout), while the run plan is generated
# from the merged tree. A stale branch can select a job whose workflow does not exist in
# the graph, which fails cryptically later. Comparing against this copy fails fast.
e2e_branch_bitrise_config() {
  local branch_config
  branch_config="$(e2e_deploy_dir)/branch-bitrise.yml"
  if [ -z "${BITRISE_PULL_REQUEST:-}" ]; then
    cp e2e/bitrise.yml "$branch_config"
  elif [ -z "${BITRISE_GIT_COMMIT:-}" ] || ! git show "${BITRISE_GIT_COMMIT}:e2e/bitrise.yml" > "$branch_config" 2>/dev/null; then
    rm -f "$branch_config"
    printf '%s\n' "Unable to read e2e/bitrise.yml from the pull request branch head. Rebase on main and push the branch again." >&2
    return 1
  fi
  printf '%s\n' "$branch_config"
}

e2e_export_github_token() {
  e2e_log "Checking GitHub reporting configuration"
  if [ -z "${GITHUB_TOKEN:-}" ]; then
    : "${GIT_HTTP_PASSWORD:?GITHUB_TOKEN or Bitrise GitHub App GIT_HTTP_PASSWORD is required. Enable Project settings > Repository > Extend GitHub App permissions to builds.}"
    export GITHUB_TOKEN="$GIT_HTTP_PASSWORD"
  fi
}

e2e_configure_storefront() {
  e2e_log "Checking storefront configuration secrets"
  : "${STOREFRONT_DOMAIN:?STOREFRONT_DOMAIN is required. Check https://app.bitrise.io/app/f51f9054-053e-40f1-81e9-ae727567ae76/workflow_editor#!/secrets and enable Expose for pull requests.}"
  : "${STOREFRONT_ACCESS_TOKEN:?STOREFRONT_ACCESS_TOKEN is required. Check https://app.bitrise.io/app/f51f9054-053e-40f1-81e9-ae727567ae76/workflow_editor#!/secrets and enable Expose for pull requests.}"
  e2e_log "Configuring storefront environment"
  ./scripts/setup_storefront_env --skip-optional-prompts
}

e2e_nightly_commit_window() {
  printf '%s\n' "${NIGHTLY_COMMIT_WINDOW:-24 hours}"
}

e2e_nightly_head_is_recent() {
  # Reads HEAD only, so this stays correct on the shallow clone git-clone@8 makes.
  if [ -n "$(git log -1 --since="$(e2e_nightly_commit_window)" --format=%H HEAD)" ]; then
    printf 'true\n'
  else
    printf 'false\n'
  fi
}

e2e_nightly_should_build() {
  local window
  window="$(e2e_nightly_commit_window)"
  local should_build
  should_build="$(e2e_nightly_head_is_recent)"
  e2e_log "HEAD committed within the last ${window}: ${should_build}"
  if [ "$should_build" != "true" ]; then
    e2e_log "Nothing landed in the last ${window}. Every later step in this workflow is skipped."
    e2e_log "Keep NIGHTLY_COMMIT_WINDOW equal to the Bitrise schedule interval, or the nightly skips or repeats work."
  fi
  envman add --key NIGHTLY_SHOULD_BUILD --value "$should_build"
}
